---
import { languageParam } from "@/lib/i18n"
import { getProjects } from "@/lib/projects"

// A project lands on its overview (or its only post): /projects/<slug>/ is a stable address that redirects there.
// GitHub Pages has no server redirects: Astro writes a meta-refresh page.
export async function getStaticPaths() {
  return (await getProjects()).map(({ slug, lang, url }) => ({
    params: { lang: languageParam(lang), slug },
    props: { to: url },
  }))
}

return Astro.redirect(Astro.props.to, 301)
---
