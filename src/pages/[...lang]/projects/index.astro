---
import ProjectCard from "@/components/ProjectCard.astro"
import Separator from "@/components/Separator.astro"
import Layout from "@/layouts/Layout.astro"
import { getTranslations, type Language, languagePaths, localizedPath } from "@/lib/i18n"
import { getProjects, type ProjectStatus } from "@/lib/projects"

export const getStaticPaths = languagePaths

const { lang } = Astro.props as { lang: Language }
const t = getTranslations(lang)

const projects = await getProjects(lang)
// What is being built right now first, then what is finished
const groups = (["in-progress", "done"] as ProjectStatus[])
  .map((status) => ({ status, projects: projects.filter((project) => project.status === status) }))
  .filter(({ projects }) => projects.length > 0)
---

<Layout
  lang={lang}
  seo={{
    title: `${t("projects.title")} · Alban Petit`,
    description: t("projects.subtitle"),
    canonicalPath: localizedPath("/projects/", lang),
    alternatePaths: { en: "/projects/", fr: "/fr/projects/" },
  }}
>
  <div class="mx-auto max-w-5xl flex flex-col gap-8">
    <div>
      <h1 class="text-4xl font-bold tracking-tight">{t("projects.title")}</h1>
      <p class="mt-2 text-muted-foreground">{t("projects.subtitle")}</p>
    </div>

    <Separator />

    {
      groups.length > 0 ? (
        groups.map(({ status, projects }, index) => (
          <section class="flex flex-col gap-5" aria-labelledby={`projects-${status}`}>
            <div class="flex items-center gap-3">
              <span class={status === "done" ? "h-5 w-1 rounded-full bg-secondary" : "h-5 w-1 rounded-full bg-primary"} />
              <h2 id={`projects-${status}`} class="text-sm font-semibold uppercase tracking-widest text-muted-foreground">
                {t(`projects.groups.${status}`)}
              </h2>
              <span class="rounded-full border px-2 py-0.5 text-xs font-medium text-muted-foreground">
                {projects.length}
              </span>
            </div>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {projects.map((project, position) => (
                <ProjectCard project={project} lang={lang} eager={index === 0 && position < 2} />
              ))}
            </div>
          </section>
        ))
      ) : (
        <p class="py-16 text-center text-muted-foreground">{t("projects.empty")}</p>
      )
    }
  </div>
</Layout>
