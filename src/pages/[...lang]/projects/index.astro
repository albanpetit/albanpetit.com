---
import { Card } from "@/components/ui/card"
import ProjectStatus from "@/components/ProjectStatus.astro"
import Separator from "@/components/Separator.astro"
import Layout from "@/layouts/Layout.astro"
import { formatDate, getTranslations, type Language, languagePaths, localizedPath } from "@/lib/i18n"
import { excerpt } from "@/lib/posts"
import { getProjects } from "@/lib/projects"

export const getStaticPaths = languagePaths

const { lang } = Astro.props as { lang: Language }
const t = getTranslations(lang)

const cards = (await getProjects(lang)).map((project) => {
  // The overview presents the project once written; until then, its latest post tells where it stands
  const lead = project.overview ?? project.posts[project.posts.length - 1]
  return { project, description: lead.data.description ?? excerpt(lead, 160) }
})
---

<Layout
  lang={lang}
  seo={{
    title: `${t("projects.title")} · Alban Petit`,
    description: t("projects.subtitle"),
    canonicalPath: localizedPath("/projects/", lang),
    alternatePaths: { en: "/projects/", fr: "/fr/projects/" },
  }}
>
  <div class="mx-auto max-w-3xl flex flex-col gap-8">
    <div>
      <h1 class="text-4xl font-bold tracking-tight">{t("projects.title")}</h1>
      <p class="mt-2 text-muted-foreground">{t("projects.subtitle")}</p>
    </div>

    <Separator />

    {
      cards.length > 0 ? (
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {cards.map(({ project, description }) => (
            <Card className="relative flex flex-col gap-3 p-5 transition-all duration-200 hover:border-primary/50 hover:shadow-md">
              <div class="flex items-start justify-between gap-3">
                <h2 class="text-lg font-semibold leading-snug">
                  <a
                    href={project.url}
                    class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-ring"
                  >
                    {project.name}
                  </a>
                </h2>
                <ProjectStatus status={project.status} lang={lang} />
              </div>
              <p class="flex-1 text-sm text-muted-foreground">{description}</p>
              <p class="text-xs text-muted-foreground">
                {t("projects.updated", { date: formatDate(project.updated, lang) })} ·{" "}
                {t("projects.postCount", { count: project.posts.length })}
              </p>
            </Card>
          ))}
        </div>
      ) : (
        <p class="py-16 text-center text-muted-foreground">{t("projects.empty")}</p>
      )
    }
  </div>
</Layout>
