---
import PostListPage from "@/components/PostListPage.astro"
import Layout from "@/layouts/Layout.astro"
import { categoryLabel } from "@/lib/category"
import { languageParam, localizedPath, getTranslations } from "@/lib/i18n"
import { getPosts } from "@/lib/posts"
import { CATEGORY_PAGES } from "@/lib/tag"
import { categoryPages } from "@/lib/taxonomy"

export async function getStaticPaths() {
  const posts = await getPosts()
  return categoryPages(posts).map((page) => ({
    params: { lang: languageParam(page.lang), category: page.slug },
    props: {
      page,
      posts: posts.filter(({ data }) => data.lang === page.lang && page.names.includes(data.category ?? "")),
    },
  }))
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"]

const { page, posts } = Astro.props as Props
const { lang, names, slug, hasAlternate } = page
// A category with a page of its own (tutorials) keeps its old /category/ address as a redirect
const ownPage = CATEGORY_PAGES[slug]
if (ownPage) return Astro.redirect(localizedPath(ownPage, lang), 301)
const t = getTranslations(lang)
const label = names.map((name) => categoryLabel(name, lang)).join(" / ")
---

<Layout
  lang={lang}
  alternatePath={hasAlternate ? undefined : "/blog/"}
  seo={{
    title: `${label} · Alban Petit`,
    description: lang === "en" ? `Posts in category ${label}` : `Articles de la catégorie ${label}`,
    canonicalPath: localizedPath(`/category/${slug}/`, lang),
    alternatePaths: hasAlternate ? { en: `/category/${slug}/`, fr: `/fr/category/${slug}/` } : undefined,
  }}
>
  <PostListPage lang={lang} title={label} subtitle={t("category.subtitle", { count: posts.length })} posts={posts} />
</Layout>
