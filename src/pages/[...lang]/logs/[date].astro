---
import "katex/dist/katex.min.css"
import { ArrowLeft, ArrowRight } from "lucide-react"
import Breadcrumb from "@/components/Breadcrumb.astro"
import LogEntry from "@/components/LogEntry.astro"
import Layout from "@/layouts/Layout.astro"
import { formatDate, getTranslations, languageParam, localizedPath } from "@/lib/i18n"
import { excerpt } from "@/lib/posts"
import { getLogs, getProjects, type Log, logDate, logPath, logSlug } from "@/lib/projects"

export async function getStaticPaths() {
  const [logs, projects] = await Promise.all([getLogs(), getProjects()])
  const keys = new Set(logs.map((log) => `${logSlug(log)}:${log.data.lang}`))
  return logs.map((log) => {
    // Newest first: the previous day is the next one in the list
    const sameLanguage = logs.filter(({ data }) => data.lang === log.data.lang)
    const index = sameLanguage.indexOf(log)
    return {
      params: { lang: languageParam(log.data.lang), date: logSlug(log) },
      props: {
        log,
        projects: projects.filter(({ data }) => data.lang === log.data.lang),
        previous: sameLanguage[index + 1] as Log | undefined,
        next: sameLanguage[index - 1] as Log | undefined,
        // A log may exist in one language only: no hreflang, and the language switch falls back to the list
        hasTranslation: keys.has(`${logSlug(log)}:${log.data.lang === "en" ? "fr" : "en"}`),
      },
    }
  })
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"]

const { log, projects, previous, next, hasTranslation } = Astro.props as Props
const { lang, title } = log.data
const t = getTranslations(lang)
const slug = logSlug(log)
const date = formatDate(logDate(log), lang)
const logsPath = localizedPath("/logs/", lang)
const dayLabel = (entry: Log) => entry.data.title ?? formatDate(logDate(entry), lang)
---

<Layout
  lang={lang}
  alternatePath={hasTranslation ? undefined : "/logs/"}
  seo={{
    title: `${title ?? date} · ${t("logs.title")} · Alban Petit`,
    description: excerpt(log, 160),
    type: "article",
    publishedAt: logDate(log).toISOString(),
    canonicalPath: logPath(log),
    alternatePaths: hasTranslation ? { en: `/logs/${slug}/`, fr: `/fr/logs/${slug}/` } : undefined,
  }}
>
  <div class="mx-auto max-w-3xl flex flex-col gap-8">
    <Breadcrumb
      label={t("a11y.breadcrumb")}
      currentClass="max-w-xs truncate"
      items={[
        { label: t("breadcrumb.home"), href: localizedPath("/", lang) },
        { label: t("logs.title"), href: logsPath },
        { label: title ?? date },
      ]}
    />

    <LogEntry log={log} projects={projects} full headingLevel="h1" />

    {
      (previous || next) && (
        <nav class="flex flex-wrap justify-between gap-4 border-t pt-6 text-sm" aria-label={t("logs.title")}>
          {previous ? (
            <a href={logPath(previous)} class="flex items-center gap-2 text-muted-foreground hover:text-foreground">
              <ArrowLeft className="h-4 w-4" aria-hidden="true" />
              <span>
                <span class="block text-xs">{t("logs.previous")}</span>
                {dayLabel(previous)}
              </span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a
              href={logPath(next)}
              class="flex items-center gap-2 text-right text-muted-foreground hover:text-foreground"
            >
              <span>
                <span class="block text-xs">{t("logs.next")}</span>
                {dayLabel(next)}
              </span>
              <ArrowRight className="h-4 w-4" aria-hidden="true" />
            </a>
          )}
        </nav>
      )
    }
  </div>
</Layout>

<script>
  import "@/scripts/chart"
  import "@/scripts/mermaid"
</script>
