---
import PostListPage from "@/components/PostListPage.astro"
import Layout from "@/layouts/Layout.astro"
import { languageParam, localizedPath, getTranslations } from "@/lib/i18n"
import { getPosts } from "@/lib/posts"
import { tagPages } from "@/lib/taxonomy"

export async function getStaticPaths() {
  const posts = await getPosts()
  return tagPages(posts).map((page) => ({
    params: { lang: languageParam(page.lang), tag: page.slug },
    props: { page, posts: posts.filter(({ data }) => data.lang === page.lang && data.tags.includes(page.name)) },
  }))
}

type Props = Awaited<ReturnType<typeof getStaticPaths>>[number]["props"]

const { page, posts } = Astro.props as Props
const { lang, name, slug, alternateSlug } = page
const t = getTranslations(lang)
const isEN = lang === "en"
---

<Layout
  lang={lang}
  alternatePath={alternateSlug ? `/tag/${alternateSlug}/` : "/blog/"}
  seo={{
    title: `#${name} · Alban Petit`,
    description: isEN ? `Posts tagged with ${name}` : `Articles tagués ${name}`,
    canonicalPath: localizedPath(`/tag/${slug}/`, lang),
    alternatePaths: alternateSlug
      ? {
          en: isEN ? `/tag/${slug}/` : `/tag/${alternateSlug}/`,
          fr: isEN ? `/fr/tag/${alternateSlug}/` : `/fr/tag/${slug}/`,
        }
      : undefined,
  }}
>
  <PostListPage
    lang={lang}
    title={t("tag.title", { tag: name })}
    subtitle={t("tag.subtitle", { count: posts.length })}
    posts={posts}
  />
</Layout>
