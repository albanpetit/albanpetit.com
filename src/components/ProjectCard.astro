---
import { getImage } from "astro:assets"
import { ArrowUpRight, CalendarDays, FileText } from "lucide-react"
import ProjectStatus from "@/components/ProjectStatus.astro"
import { badgeVariants } from "@/components/ui/badge"
import { formatDate, getTranslations, type Language } from "@/lib/i18n"
import { excerpt, postPath } from "@/lib/posts"
import type { Project } from "@/lib/projects"
import { tagPath } from "@/lib/tag"
import { cn } from "@/lib/utils"

interface Props {
  project: Project
  lang: Language
  /** Above the fold: the first covers load eagerly, the rest lazily */
  eager?: boolean
}

const { project, lang, eager = false } = Astro.props
const t = getTranslations(lang)

// The overview presents the project once written; until then, its latest post tells where it stands
const latest = project.posts.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime())[0]
const lead = project.overview ?? latest
const description = lead.data.description ?? excerpt(lead, 160)

// The overview's image, else the most recent one among its posts
const image =
  project.overview?.data.image ??
  project.posts.toSorted((a, b) => b.data.date.getTime() - a.data.date.getTime()).find(({ data }) => data.image)?.data
    .image
const cover = image
  ? await getImage({ src: image, width: 800, height: 450, widths: [400, 640, 800, 1200], fit: "cover" })
  : undefined

// Most used tags across its posts
const counts = new Map<string, number>()
for (const tag of project.posts.flatMap(({ data }) => data.tags)) counts.set(tag, (counts.get(tag) ?? 0) + 1)
const tags = [...counts.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 4)
  .map(([tag]) => tag)

const showLatest = project.posts.length > 1 && latest !== project.overview
---

<article
  class="group relative flex flex-col overflow-hidden rounded-xl border bg-card text-card-foreground shadow transition-all duration-300 hover:-translate-y-1 hover:border-primary/60 hover:shadow-xl motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <div class="relative aspect-[16/9] overflow-hidden bg-muted">
    {
      cover ? (
        <img
          src={cover.src}
          srcset={cover.srcSet.attribute}
          sizes="(min-width: 1024px) 30rem, (min-width: 768px) 50vw, 100vw"
          width={cover.attributes.width}
          height={cover.attributes.height}
          alt=""
          loading={eager ? "eager" : "lazy"}
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105 motion-reduce:transition-none"
        />
      ) : (
        // No photo yet: a blueprint-like panel with the project's initial
        <div
          class="flex h-full w-full items-center justify-center bg-gradient-to-br from-secondary/25 via-card to-primary/30"
          aria-hidden="true"
        >
          <div class="absolute inset-0 bg-[radial-gradient(hsl(var(--foreground)/0.12)_1px,transparent_1px)] [background-size:16px_16px]" />
          <div class="absolute inset-6 rounded-lg border border-dashed border-foreground/15" />
          <span class="relative text-7xl font-black tracking-tighter text-foreground/80 transition-transform duration-500 group-hover:scale-110 motion-reduce:transition-none">
            {project.name.slice(0, 2)}
          </span>
        </div>
      )
    }
    <ProjectStatus status={project.status} lang={lang} class="absolute left-3 top-3" />
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <h3 class="flex items-start justify-between gap-3 text-xl font-bold leading-snug tracking-tight">
      <a
        href={project.url}
        class="transition-colors group-hover:text-link after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none focus-visible:after:ring-2 focus-visible:after:ring-ring"
      >
        {project.name}
      </a>
      <ArrowUpRight
        className="mt-1 h-5 w-5 shrink-0 text-muted-foreground transition-all duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-link"
        aria-hidden="true"
      />
    </h3>

    <p class="line-clamp-3 text-sm text-muted-foreground">{description}</p>

    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <li>
              <a href={tagPath(tag, lang)} class={cn(badgeVariants({ variant: "outline" }), "relative z-10 font-medium hover:bg-accent")}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {
      showLatest && (
        <p class="text-sm">
          <span class="text-muted-foreground">{t("projects.latest")} · </span>
          <a href={postPath(latest)} class="relative z-10 font-medium text-link hover:underline">
            {latest.data.title}
          </a>
        </p>
      )
    }

    <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 border-t pt-3 text-xs text-muted-foreground">
      <span class="inline-flex items-center gap-1.5">
        <CalendarDays className="h-3.5 w-3.5" aria-hidden="true" />
        {t("projects.updated", { date: formatDate(project.updated, lang) })}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <FileText className="h-3.5 w-3.5" aria-hidden="true" />
        {t("projects.postCount", { count: project.posts.length })}
      </span>
      {/* One segment per post: how far the story has gone */}
      <span class="ml-auto flex gap-1" aria-hidden="true">
        {project.posts.map(() => (
          <span class={cn("h-1.5 w-4 rounded-full", project.status === "done" ? "bg-secondary" : "bg-primary")} />
        ))}
      </span>
    </div>
  </div>
</article>
