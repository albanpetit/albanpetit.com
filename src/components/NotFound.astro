---
import { ArrowLeft } from "lucide-react"
import { buttonVariants } from "@/components/ui/button"
import Layout from "@/layouts/Layout.astro"
import { type Language, localizedPath, getTranslations, otherLanguage } from "@/lib/i18n"

const { lang } = Astro.props as { lang: Language }
const t = getTranslations(lang)
// GitHub Pages serves this one 404.html for every missing URL, /fr/ ones included: say it in both languages
const other = otherLanguage(lang)
const tOther = getTranslations(other)
---

<Layout lang={lang} seo={{ title: "404 · Alban Petit", noindex: true }}>
  <div class="flex flex-col items-center justify-center gap-8 py-24 text-center">
    <div class="relative select-none">
      <span
        class="text-[10rem] md:text-[14rem] font-black leading-none text-primary/20 dark:text-primary/10 tracking-tighter"
      >
        404
      </span>
      <span
        class="absolute inset-0 flex items-center justify-center text-[10rem] md:text-[14rem] font-black leading-none text-primary/60 tracking-tighter blur-sm"
      >
        404
      </span>
    </div>
    <div class="flex flex-col gap-3 -mt-8">
      <h1 class="text-2xl font-bold tracking-tight">{t("404.subtitle")}</h1>
      <p class="text-muted-foreground max-w-sm">{t("404.description")}</p>
    </div>
    <a href={localizedPath("/", lang)} class={buttonVariants({ size: "lg" })}>
      <ArrowLeft className="mr-2 h-4 w-4" />
      {t("404.backHome")}
    </a>
    <p lang={other} class="text-sm text-muted-foreground">
      {tOther("404.subtitle")} ·{" "}
      <a href={localizedPath("/", other)} hreflang={other} class="text-link underline underline-offset-4">
        {tOther("404.backHome")}
      </a>
    </p>
  </div>
</Layout>
