---
import { getTranslations, type Language } from "@/lib/i18n"
import type { ProjectStatus } from "@/lib/projects"
import { cn } from "@/lib/utils"

interface Props {
  status: ProjectStatus
  lang: Language
}

const { status, lang } = Astro.props
const t = getTranslations(lang)

const styles: Record<ProjectStatus, string> = {
  "in-progress": "border-primary/60 bg-primary/15 text-foreground",
  done: "border-link/40 bg-link/10 text-link",
}
---

<span class={cn("inline-flex shrink-0 items-center rounded-full border px-2.5 py-0.5 text-xs font-medium", styles[status])}>
  {t(`projects.status.${status}`)}
</span>
