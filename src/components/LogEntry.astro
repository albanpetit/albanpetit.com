---
import { render } from "astro:content"
import { badgeVariants } from "@/components/ui/badge"
import { formatDate, getTranslations } from "@/lib/i18n"
import { excerpt } from "@/lib/posts"
import { type Log, logDate, logPath, type Project, projectPath } from "@/lib/projects"
import { cn } from "@/lib/utils"

/** One daily log: its day, its projects, and either its whole text or an excerpt linking to it */
interface Props {
  log: Log
  /** Projects of the log's language, to name and link the ones it belongs to */
  projects: Project[]
  full?: boolean
  /** h1 on the log's own page */
  headingLevel?: "h1" | "h2" | "h3"
  /** Leave out this project's badge (on its own page, it would only repeat the page title) */
  currentProject?: string
}

const { log, projects, full = false, headingLevel: Heading = "h2", currentProject } = Astro.props
const { lang, title } = log.data
const t = getTranslations(lang)
const date = formatDate(logDate(log), lang)
const logProjects = log.data.projects
  .filter((slug) => slug !== currentProject)
  .map((slug) => projects.find(({ data }) => data.slug === slug && data.lang === lang))
  .filter((project) => project !== undefined)
const { Content } = full ? await render(log) : { Content: undefined }
// On the log's own page, its title does not link to itself
const TitleLink = Heading === "h1" ? "span" : "a"
---

<article class="flex flex-col gap-3 border-l-2 border-primary/60 pl-5">
  <header class="flex flex-col gap-2">
    <Heading class={Heading === "h1" ? "text-3xl font-bold tracking-tight" : "text-lg font-semibold leading-snug"}>
      <TitleLink
        href={Heading === "h1" ? undefined : logPath(log)}
        class={Heading === "h1" ? undefined : "hover:text-link transition-colors"}
      >
        {
          title ? (
            <>
              <span class="block text-sm font-normal text-muted-foreground">
                <time datetime={logDate(log).toISOString().slice(0, 10)}>{date}</time>
              </span>
              {title}
            </>
          ) : (
            <time datetime={logDate(log).toISOString().slice(0, 10)}>{date}</time>
          )
        }
      </TitleLink>
    </Heading>
    {
      logProjects.length > 0 && (
        <ul class="flex flex-wrap gap-1.5" aria-label={t("logs.projects")}>
          {logProjects.map((project) => (
            <li>
              <a
                href={projectPath(project)}
                class={cn(badgeVariants({ variant: "secondary" }), "hover:bg-accent transition-colors")}
              >
                {project.data.title}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </header>
  {
    Content ? (
      <div class="prose prose-neutral dark:prose-invert max-w-none">
        <Content />
      </div>
    ) : (
      <p class="text-sm text-muted-foreground">{excerpt(log, 220)}</p>
    )
  }
</article>
