---
import Breadcrumb from "@/components/Breadcrumb.astro"
import PostCard from "@/components/PostCard"
import Separator from "@/components/Separator.astro"
import { type Language, localizedPath, getTranslations } from "@/lib/i18n"
import { type Post, toCardData } from "@/lib/posts"

/** Body of the tag, category and tutorials pages: breadcrumb, title and the matching posts */
interface Props {
  lang: Language
  title: string
  subtitle: string
  posts: Post[]
  /** A page of the navigation (tutorials) sits right under the home page, not under the posts */
  topLevel?: boolean
}

const { lang, title, subtitle, posts, topLevel = false } = Astro.props
const t = getTranslations(lang)
const cards = await Promise.all(posts.map(toCardData))
---

<div class="flex flex-col gap-8">
  <div>
    <Breadcrumb
      class="mb-4"
      label={t("a11y.breadcrumb")}
      items={[
        { label: t("breadcrumb.home"), href: localizedPath("/", lang) },
        ...(topLevel ? [] : [{ label: t("nav.blog"), href: localizedPath("/blog/", lang) }]),
        { label: title },
      ]}
    />
    <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
    <p class="mt-2 text-muted-foreground">{subtitle}</p>
  </div>

  <Separator />

  <div class="flex flex-col gap-4">
    {cards.map((post) => <PostCard post={post} />)}
  </div>
</div>
